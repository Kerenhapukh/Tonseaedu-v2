generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  namaLengkap String
  username    String   @unique
  email       String?
  namaSekolah String?
  nomorTelepon String?
  password    String
  role        String   @default("user") // "admin" (Guru) atau "user" (Siswa)
  kelas       String? // Contoh: "7A", "7B", "8A", "9B"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi progression
  materiProgress MateriProgress[]

  @@map("users")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  materi      Materi[]
  kosakata    Kosakata[]
  questions   Question[]

  @@map("categories")
}

model Materi {
  id         Int      @id @default(autoincrement())
  judul      String
  konten     String   @db.Text
  bab        String?
  ringkasan  String?  @db.Text
  videoUrl   String?
  kelas      String?
  sequence   Int      @default(0) // Urutan materi dalam satu kelas (0, 1, 2, ...)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relasi progression
  progress  MateriProgress[]
  questions Question[] // Soal khusus untuk materi ini (opsional)

  @@map("materi")
}

model Kosakata {
  id         Int      @id @default(autoincrement())
  tonsea     String
  indonesia  String
  audioUrl   String?
  kelas      String?  // Kelas: "7", "8", "9"
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("kosakata")
}

model Question {
  id            Int      @id @default(autoincrement())
  pertanyaan    String
  correctAnswer String
  options       String[]
  kelas         String?  // Kelas: "7", "8", "9"
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    Int

  // BARU: kaitkan soal ke materi tertentu (opsional).
  // Jika null, soal ini adalah soal umum berdasarkan kelas (perilaku lama tetap jalan).
  materi     Materi? @relation(fields: [materiId], references: [id], onDelete: SetNull)
  materiId   Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([materiId])
  @@map("questions")
}

model Score {
  id             Int      @id @default(autoincrement())
  username       String
  kelas          String? // Kelas siswa saat mengerjakan kuis
  score          Int
  totalQuestions Int
  createdAt      DateTime @default(now())

  @@index([username])
  @@map("scores")
}

// Melacak progres siswa per materi (untuk quiz-gate / progression)
model MateriProgress {
  id       Int    @id @default(autoincrement())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  materi   Materi @relation(fields: [materiId], references: [id], onDelete: Cascade)
  materiId Int

  // "completed" jika sudah lulus kuis materi ini.
  // Materi terbuka bila: sequence 0, ATAU materi sebelumnya sudah "completed".
  status      String    @default("locked")
  quizScore   Int? // Nilai kuis terakhir (0-100)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, materiId])
  @@index([userId])
  @@map("materi_progress")
}
