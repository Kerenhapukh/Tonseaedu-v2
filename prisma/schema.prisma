generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  namaLengkap    String
  username       String           @unique
  password       String
  role           String           @default("user")
  kelas          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  email          String?
  namaSekolah    String?
  nomorTelepon   String?
  materiProgress MateriProgress[]

  @@map("users")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  kosakata    Kosakata[]
  materi      Materi[]
  questions   Question[]

  @@map("categories")
}

model Materi {
  id         Int              @id @default(autoincrement())
  judul      String
  konten     String
  categoryId Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  kelas      String?
  bab        String?
  ringkasan  String?
  videoUrl   String?
  sequence   Int              @default(0)
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  progress   MateriProgress[]
  questions  Question[]

  @@map("materi")
}

model Kosakata {
  id         Int      @id @default(autoincrement())
  tonsea     String
  indonesia  String
  audioUrl   String?
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  kelas      String?
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("kosakata")
}

model Question {
  id            Int      @id @default(autoincrement())
  pertanyaan    String
  correctAnswer String
  options       String[]
  categoryId    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  kelas         String?
  materiId      Int?
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  materi        Materi?  @relation(fields: [materiId], references: [id])

  @@index([materiId])
  @@map("questions")
}

model Score {
  id             Int      @id @default(autoincrement())
  username       String
  kelas          String?
  score          Int
  totalQuestions Int
  createdAt      DateTime @default(now())

  @@index([username])
  @@map("scores")
}

model MateriProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  materiId    Int
  status      String    @default("locked")
  quizScore   Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  materi      Materi    @relation(fields: [materiId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, materiId])
  @@index([userId])
  @@map("materi_progress")
}
